<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<Package
		Name="Nexus IT"
		Manufacturer="Nitheraz"
		Version="1.0.0.0"
		UpgradeCode="f21a7d79-04be-48c4-b434-b754a237a038"
		Scope="perMachine">

		<MajorUpgrade
            DowngradeErrorMessage="A newer version of Nexus IT is already installed." />

		<MediaTemplate />

		<!-- Nexus IT application icon -->
		<Icon
            Id="NexusITIcon"
            SourceFile="..\NexusIT\Assets\NexusIT.ico" />

		<Property
            Id="ARPPRODUCTICON"
            Value="NexusITIcon" />

		<!-- Installer licence agreement -->
		<WixVariable
            Id="WixUILicenseRtf"
            Value="License.rtf" />
		
		<!-- Nexus IT installer branding -->
		<WixVariable
			Id="WixUIBannerBmp"
			Value="NexusIT-Installer-Banner.png" />

		<WixVariable
			Id="WixUIDialogBmp"
			Value="NexusIT-Installer-Dialog.png" />

		<!-- Installation directory -->
		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory
                Id="INSTALLFOLDER"
                Name="Nexus IT" />
		</StandardDirectory>

		<!-- Start Menu directory -->
		<StandardDirectory Id="ProgramMenuFolder">
			<Directory
                Id="ApplicationProgramsFolder"
                Name="Nexus IT" />
		</StandardDirectory>

		<Feature
            Id="MainFeature"
            Title="Nexus IT"
            Level="1">

			<!-- Application publish files -->
			<Files
				Include="publish\**"
				Directory="INSTALLFOLDER" />

			<!-- Start Menu shortcut -->
			<Component
                Id="StartMenuShortcut"
                Directory="ApplicationProgramsFolder"
                Guid="*">

				<Shortcut
                    Id="NexusITStartMenuShortcut"
                    Name="Nexus IT"
                    Description="Nexus IT Administration Tools"
                    Target="[INSTALLFOLDER]NexusIT.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="NexusITIcon" />

				<RemoveFolder
                    Id="RemoveNexusITStartMenuFolder"
                    On="uninstall" />

				<RegistryValue
                    Root="HKCU"
                    Key="Software\Nitheraz\NexusIT"
                    Name="StartMenuShortcut"
                    Type="integer"
                    Value="1"
                    KeyPath="yes" />

			</Component>

		</Feature>

		<!-- Standard installer wizard -->
		<ui:WixUI
			Id="WixUI_InstallDir"
			InstallDirectory="INSTALLFOLDER" />

	</Package>

</Wix>
