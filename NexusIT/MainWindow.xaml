<Window x:Class="NexusIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus IT"
        Width="1440"
        Height="900"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource PrimaryText}"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background" Value="#1F2937"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="#253041"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="18,20,18,16">

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30">
                    <Border Width="44" Height="44"
                            HorizontalAlignment="Left"
                            Background="#1D3557"
                            CornerRadius="12">
                        <TextBlock Text="N"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#93C5FD"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Nexus IT"
                               FontSize="23"
                               FontWeight="Bold"
                               Margin="0,13,0,3"/>

                    <TextBlock Text="IT ADMINISTRATION"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Height="1" Background="#253041"
                            Margin="0,0,0,14"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Tag="Settings"
                            Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="30"
                                       FontSize="17"
                                       Foreground="#9CA3AF"/>
                            <TextBlock Text="Settings"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="WORKSPACE"
                                   Foreground="#6B7280"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,10"/>

                        <Button x:Name="DashboardNav"
                                Style="{StaticResource NavigationButton}"
                                Tag="Dashboard"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" Width="30" FontSize="19"/>
                                <TextBlock Text="Dashboard"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButton}"
                                Tag="Chromebooks"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▣" Width="30" FontSize="17"/>
                                <TextBlock Text="Chromebooks"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButton}"
                                Tag="Google Groups"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="♙" Width="30" FontSize="19"/>
                                <TextBlock Text="Google Groups"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButton}"
                                Tag="Active Directory"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌘" Width="30" FontSize="18"/>
                                <TextBlock Text="Active Directory"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButton}"
                                Tag="MECM / SCCM"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▤" Width="30" FontSize="18"/>
                                <TextBlock Text="MECM / SCCM"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButton}"
                                Tag="RDP"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▱" Width="30" FontSize="19"/>
                                <TextBlock Text="RDP"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavigationButton}"
                                Tag="Admin Tools"
                                Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚒" Width="30" FontSize="18"/>
                                <TextBlock Text="Admin Tools"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#253041"
                    BorderThickness="0,0,0,1"
                    Padding="30,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentPageTitle"
                                   Text="Dashboard"
                                   Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="CurrentPageSubtitle"
                                   Text="Your central workspace for IT administration."
                                   Foreground="{StaticResource SecondaryText}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#172B25"
                            BorderBrush="#285342"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7"
                                     Fill="#4ADE80"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Workspace ready"
                                       Foreground="#86EFAC"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="MainContent"
                                Margin="30,26,30,30"/>
            </ScrollViewer>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="#0B1220"
                BorderBrush="#253041"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="Nexus IT  •  Initial build"
                           FontSize="11"
                           Foreground="#6B7280"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
