<UserControl x:Class="NexusIT.App.Views.Rdp.RdpManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="CaretBrush" Value="#F9FAFB"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Remote Desktop Connections"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#F9FAFB"/>

                <TextBlock Text="Save and launch remote computer sessions."
                           Foreground="#9CA3AF"
                           FontSize="12"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+  New Connection"
                    Style="{StaticResource PrimaryButton}"
                    Click="NewConnection_Click"/>
        </Grid>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- CONNECTION LIST -->
            <Border Grid.Column="0"
                    Background="#1F2937"
                    BorderBrush="#303B4B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Saved connections"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F9FAFB"
                               Margin="0,0,0,14"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="1"
                             Style="{StaticResource FieldInput}"
                             Margin="0,0,0,14"
                             Padding="10,8"
                             ToolTip="Search by connection name or computer name"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <ListView x:Name="ConnectionsList"
                              Grid.Row="2"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#F9FAFB"
                              SelectionChanged="ConnectionsList_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="#172033"/>
                                <Setter Property="BorderBrush" Value="#29364B"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#1D3557"/>
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="#3B82F6"/>
                                                </Trigger>

                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#273449"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            Background="#1D3557"
                                            CornerRadius="7"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="▱"
                                                   FontSize="20"
                                                   Foreground="#93C5FD"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#F9FAFB"/>

                                        <TextBlock Text="{Binding DisplayAddress}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="ConnectionCountText"
                               Grid.Row="3"
                               Text="0 connections"
                               Foreground="#6B7280"
                               FontSize="11"
                               Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- DETAILS PANEL -->
            <Border Grid.Column="2"
                    Background="#1F2937"
                    BorderBrush="#303B4B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle"
                                   Text="Connection details"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#F9FAFB"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Connection name"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="NameTextBox"
                                 Style="{StaticResource FieldInput}"/>

                        <TextBlock Text="Computer name / IP address"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="HostTextBox"
                                 Style="{StaticResource FieldInput}"/>

                        <TextBlock Text="Username (optional)"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource FieldInput}"/>

                        <TextBlock Text="Display settings"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F9FAFB"
                                   Margin="0,4,0,12"/>

                        <CheckBox x:Name="AdminSessionCheckBox"
                                  Content="Connect to administrative session"
                                  Foreground="#D1D5DB"
                                  Margin="0,0,0,10"/>

                        <CheckBox x:Name="FullScreenCheckBox"
                                  Content="Start in full screen"
                                  Foreground="#D1D5DB"
                                  Margin="0,0,0,10"/>

                        <CheckBox x:Name="AllMonitorsCheckBox"
                                  Content="Use all monitors"
                                  Foreground="#D1D5DB"
                                  Margin="0,0,0,14"/>

                        <TextBlock Text="Passwords are not stored in connection profiles."
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,18"/>

                        <!-- ACTION BUTTONS -->
                        <WrapPanel>
                            <Button Content="Save"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,8"
                                    Click="SaveConnection_Click"/>

                            <Button Content="Connect"
                                    Style="{StaticResource SuccessButton}"
                                    Margin="0,0,8,8"
                                    Click="Connect_Click"/>

                            <Button Content="Delete"
                                    Style="{StaticResource DangerButton}"
                                    Margin="0,0,8,8"
                                    Click="DeleteConnection_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="EditorStatusText"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
